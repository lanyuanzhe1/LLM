# FastAPI 服务地址。仅由 Next.js 服务端代理读取，不会暴露云端密钥。
GRAIN_API_BASE_URL=http://127.0.0.1:8000

# services/webui 认证服务地址，仅由 Next.js 服务端认证代理读取。
WEBUI_BASE_URL=http://127.0.0.1:8080

# Next.js 同域挂载路径。两项保持一致；NEXT_PUBLIC_* 会写入浏览器构建产物。
BASEPATH=/agents
NEXT_PUBLIC_BASE_PATH=/agents

# ChatDoc 下载清单（每文件 chunk 统计）。相对路径以 frontend/plaza 为工作目录。
VECTOR_STORE_REPORT=../../vector_store/base/download_report.json
